<mvc:View controllerName="cnh.ab.activebilling.controller.Main" height="100%" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns="sap.m" xmlns:f="sap.f" xmlns:fb="sap.ui.comp.filterbar" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" xmlns:svm="sap.ui.comp.smartvariants" xmlns:table="sap.ui.table">
	<f:DynamicPage headerExpanded="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<svm:SmartVariantManagement 
						id="svm" 
						showExecuteOnSelection="true"
						manage=".onManageVariants"
						save=".onSaveVariant"
						afterSave=".onAfterSaveVariant"
						initialise=".onInitialiseVariants"
						standardText="Standard"
						select=".onSelectVariant"/>
				</f:heading>
				<f:actions>
					<Select id="languageSelector" 
						items="{/availableLanguages}" 
						selectedKey="{/currentLanguage}"
						change=".onLanguageChange"
						width="8rem">
						<core:Item key="{key}" text="{text}"/>
					</Select>
				</f:actions>
				<f:expandedContent>
					<Title text="{i18n>activeBillingTitle}"/>
				</f:expandedContent>
				<f:snappedContent>
					<Title text="{i18n>activeBillingTitle}"/>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<fb:FilterBar id="filterbar" persistencyKey="myPersKey" useToolbar="false" 
                    search=".onSearch" filterChange=".onFilterChange" clear=".onClear" showClearOnFB="true" afterVariantLoad=".onAfterVariantLoad">
                    <fb:filterGroupItems>

                        <!-- BUKRS (Company, free text, multi input) -->
                     <fb:FilterGroupItem name="BUKRS" label="{i18n>bukrs}" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <MultiInput id="multiInput1"
                                        customData:prop="BUKRS"
                                        showSuggestion="false"
                                        width="70%"
                                        showValueHelp="false"
                                        tokenUpdate=".onMultiInputTokenUpdate"
                                        change=".onMultiInputChange" />
                        </fb:control>
                    </fb:FilterGroupItem>

                        <!-- BELNR (Document Number, free text, multi input) -->
                        <fb:FilterGroupItem name="BELNR" label="{i18n>belnr}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                 <MultiInput id="multiInput2"
                                        customData:prop="BELNR"
                                        showSuggestion="false"
                                        width="70%"
                                        showValueHelp="false"
                                        tokenUpdate=".onMultiInputTokenUpdate"
                                        change=".onMultiInputChange" />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- GJAHR (Year range, default current year) -->
                        <fb:FilterGroupItem name="GJAHR" label="{i18n>gjahr}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DateRangeSelection delimiter="-" displayFormat="yyyy" valueFormat="yyyy"
                                    value="{ 'type': 'sap.ui.model.type.DateInterval', 'parts': [
                                        { 'path': 'filterModel>/YearFrom', 'type': 'sap.ui.model.type.Date', 'formatOptions': { 'pattern': 'yyyy' }},
                                        { 'path': 'filterModel>/YearTo', 'type': 'sap.ui.model.type.Date', 'formatOptions': { 'pattern': 'yyyy' }}
                                    ] }"
                                    change=".onDateRangeChange"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- BLDAT (Document Date, date picker) -->
                        <fb:FilterGroupItem name="BLDAT" label="{i18n>bldat}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DatePicker value="{filterModel>/BLDAT}" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd" change=".onDatePickerChange"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- BLART (Document Type, match code / dropdown) -->
                        <fb:FilterGroupItem name="BLART" label="{i18n>blart}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <ComboBox selectedKey="{filterModel>/BLART}" items="{MatchCodeModel>/DocTypes}" change=".onComboBoxChange">
                                    <core:Item key="{MatchCodeModel>key}" text="{MatchCodeModel>name}"/>
                                </ComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- AWSYS (Origin System, match code dropdown, fixed values) -->
                        <fb:FilterGroupItem name="AWSYS" label="{i18n>awsys}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <ComboBox selectedKey="{filterModel>/AWSYS}" change=".onComboBoxChange">
                                    <core:Item key="MISC" text="MISC"/>
                                    <core:Item key="VEHI" text="VEHI"/>
                                    <core:Item key="CONT" text="CONT"/>
                                    <core:Item key="WPM"  text="WPM"/>
                                    <core:Item key="CSPS" text="CSPS"/>
                                </ComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- STATUS (Document Status, multi input, match code values) -->
                        <fb:FilterGroupItem name="STATUS" label="{i18n>status}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <MultiComboBox selectedKeys="{filterModel>/STATUS}" change=".onMultiComboBoxChange">
                                    <core:Item key="01-NEW" text="01-NEW"/>
                                    <core:Item key="02-WAIT" text="02-WAIT"/>
                                    <core:Item key="03-SENT" text="03-SENT"/>
                                    <core:Item key="04-CANC" text="04-CANC"/>
                                    <core:Item key="05-BTP_ERR" text="05-BTP_ERR"/>
                                    <core:Item key="06-DT_ERR" text="06-DT_ERR"/>
                                    <core:Item key="07-RESEND" text="07-RESEND"/>
                                    <core:Item key="08-COMPLETED" text="08-COMPLETED"/>
                                    <core:Item key="09-COMM_ERR" text="09-COMM_ERR"/>
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- KUNNR (Client Code, dropdown with search, filtered by BUKRS) -->
                        <fb:FilterGroupItem name="KUNNR" label="{i18n>kunnr}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <ComboBox selectedKey="{filterModel>/KUNNR}" showSecondaryValues="true" filterSuggests="true" items="{ClientCodeModel>/Clients}" change=".onComboBoxChange">
                                    <core:Item key="{ClientCodeModel>KUNNR}" text="{ClientCodeModel>KUNNR}" additionalText="{ClientCodeModel>Name}"/>
                                </ComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                    </fb:filterGroupItems>
                </fb:FilterBar>

				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<table:Table id="tableDocuments"
				width="100%"
				visibleRowCountMode="Auto"
				minAutoRowCount="5"
				selectionMode="Single"
				fixedColumnCount="4"
				rows="{ path: 'app>/rows' }">
				<table:extension>
					<OverflowToolbar class="sapUiMediumMarginTop">
						<Title text="{i18n>DocumentListTable}" level="H2"/>
						<ToolbarSpacer/>
						<Button text="{i18n>ResendBtn}" type="Emphasized" customData:function="Resend" press=".onTableBtnPressed"/>
						<Button text="{i18n>CancelBtn}" type="Emphasized" customData:function="Cancel" press=".onTableBtnPressed"/>
						<!-- <Button text="Visualizza HTML" type="Emphasized" press="onDisplayHTML"/> -->
					</OverflowToolbar>
				</table:extension>
				<table:columns>
					<table:Column width="8rem" sortProperty="BUKRS" filterProperty="BUKRS">
						<Label text="{i18n>bukrs}"/>
						<table:template>
							<Text text="{app>BUKRS}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="BELNR" filterProperty="BELNR">
						<Label text="{i18n>belnr}"/>
						<table:template>
							<Text text="{app>BELNR}"/>
						</table:template>
					</table:Column>
					<table:Column width="6rem" sortProperty="GJAHR" filterProperty="GJAHR">
						<Label text="{i18n>gjahr}"/>
						<table:template>
							<Text text="{app>GJAHR}"/>
						</table:template>
					</table:Column>
					<table:Column width="15rem">
						<table:template>
						<HBox>
							<Button 
								text="{i18n>mainHistoryBtn}" 
								type="Transparent" 
								icon="sap-icon://history"
								press=".onHistoryPressed"
								tooltip="{i18n>mainHistoryTooltip}"/>

							<Button 
								text="{i18n>mainAckUserBtn}" 
								type="Transparent" 
								icon="sap-icon://account"
								press=".onAckUserPressed"
								enabled="{= ${app>ACK_CODE} === '5' &amp;&amp; (${app>STATUS} === '01-NEW' || ${app>STATUS} === '02-WAIT' || ${app>STATUS} === '03-SENT' || ${app>STATUS} === '05-BTP_ERR' || ${app>STATUS} === '06-DT_ERR' || ${app>STATUS} === '09-COMM_ERR')}"
								tooltip="{i18n>mainAckUserTooltip}"/>
						</HBox>
						</table:template>
					</table:Column>
					<table:Column width="8rem" sortProperty="FISC_RAP" filterProperty="FISC_RAP">
						<Label text="{i18n>fisc_rap}"/>
						<table:template>
							<Text text="{app>FISC_RAP}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="INV_TYPE" filterProperty="INV_TYPE">
						<Label text="{i18n>inv_type}"/>
						<table:template>
							<Text text="{app>INV_TYPE}"/>
						</table:template>
					</table:Column>
					<table:Column width="8rem" sortProperty="BLART" filterProperty="BLART">
						<Label text="{i18n>blart}"/>
						<table:template>
							<Text text="{app>BLART}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="BLDAT" filterProperty="BLDAT">
						<Label text="{i18n>bldat}"/>
						<table:template>
							<Text text="{ path: 'app>BLDAT', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="BUDAT" filterProperty="BUDAT">
						<Label text="{i18n>budat}"/>
						<table:template>
							<Text text="{ path: 'app>BUDAT', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					<table:Column width="8rem" sortProperty="CURRENCY" filterProperty="CURRENCY">
						<Label text="{i18n>currency}"/>
						<table:template>
							<Text text="{app>CURRENCY}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="VBELN" filterProperty="VBELN">
						<Label text="{i18n>vbeln}"/>
						<table:template>
							<Text text="{app>VBELN}"/>
						</table:template>
					</table:Column>
					<table:Column width="12rem" sortProperty="DOC_TYPE_BTP" filterProperty="DOC_TYPE_BTP">
						<Label text="{i18n>doc_type_btp}"/>
						<table:template>
							<Text text="{app>DOC_TYPE_BTP}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="KUNNR" filterProperty="KUNNR">
						<Label text="{i18n>kunnr}"/>
						<table:template>
							<Text text="{app>KUNNR}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="COUNTRY" filterProperty="COUNTRY">
						<Label text="{i18n>country}"/>
						<table:template>
							<Text text="{app>COUNTRY}"/>
						</table:template>
					</table:Column>
					<table:Column width="16rem" sortProperty="KSEF_ID" filterProperty="KSEF_ID">
						<Label text="{i18n>ksef_id}"/>
						<table:template>
							<Text text="{app>KSEF_ID}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="KSEF_DATE" filterProperty="KSEF_DATE">
						<Label text="{i18n>ksef_date}"/>
						<table:template>
							<Text text="{ path: 'app>KSEF_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="STATUS" filterProperty="STATUS">
						<Label text="{i18n>status}"/>
						<table:template>
							<Text text="{app>STATUS}"/>
						</table:template>
					</table:Column>
					<table:Column width="12rem" sortProperty="INSERT_DATE" filterProperty="INSERT_DATE">
						<Label text="{i18n>insert_date}"/>
						<table:template>
							<Text text="{ path: 'app>INSERT_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					<table:Column width="12rem" sortProperty="UPDATE_DATE" filterProperty="UPDATE_DATE">
						<Label text="{i18n>update_date}"/>
						<table:template>
							<Text text="{ path: 'app>UPDATE_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					<table:Column width="12rem" sortProperty="USER_UPDATE" filterProperty="USER_UPDATE">
						<Label text="{i18n>user_update}"/>
						<table:template>
							<Text text="{app>USER_UPDATE}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="ACK_CODE" filterProperty="ACK_CODE">
						<Label text="{i18n>ack_code}"/>
						<table:template>
							<Text text="{app>ACK_CODE}"/>
						</table:template>
					</table:Column>
					<table:Column width="18rem" sortProperty="ACK_DESCRIPTION" filterProperty="ACK_DESCRIPTION">
						<Label text="{i18n>ack_description}"/>
						<table:template>
							<Text text="{app>ACK_DESCRIPTION}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="ACK_DATE" filterProperty="ACK_DATE">
						<Label text="{i18n>ack_date}"/>
						<table:template>
							<Text text="{ path: 'app>ACK_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="ACK_TIME" filterProperty="ACK_TIME">
						<Label text="{i18n>ack_time}"/>
						<table:template>
							<Text text="{ path: 'app>ACK_TIME', formatter: '.formatter.formatTimeString' }"/>
						</table:template>
					</table:Column>
					<table:Column width="12rem" sortProperty="ACK_USER" filterProperty="ACK_USER">
						<Label text="{i18n>ack_user}"/>
						<table:template>
							<Text text="{app>ACK_USER}"/>
						</table:template>
					</table:Column>
					<table:Column width="16rem" sortProperty="ACK_USER_DESCR" filterProperty="ACK_USER_DESCR">
						<Label text="{i18n>ack_user_descr}"/>
						<table:template>
							<Text text="{app>ACK_USER_DESCR}"/>
						</table:template>
					</table:Column>
					<table:Column width="8rem" sortProperty="AWSYS" filterProperty="AWSYS">
						<Label text="{i18n>awsys}"/>
						<table:template>
							<Text text="{app>AWSYS}"/>
						</table:template>
					</table:Column>
				</table:columns>
			</table:Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
