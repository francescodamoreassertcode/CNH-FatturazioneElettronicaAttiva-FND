<mvc:View controllerName="cnh.ab.activebilling.controller.Main" height="100%" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns="sap.m" xmlns:f="sap.f" xmlns:fb="sap.ui.comp.filterbar" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" xmlns:svm="sap.ui.comp.smartvariants" xmlns:table="sap.ui.table">
	<f:DynamicPage headerExpanded="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<svm:SmartVariantManagement 
						id="svm" 
						showExecuteOnSelection="true"
						manage=".onManageVariants"
						save=".onSaveVariant"
						afterSave=".onAfterSaveVariant"
						initialise=".onInitialiseVariants"
						standardText="Standard"
						select=".onSelectVariant"/>
				</f:heading>
				<f:actions>
					<Select id="languageSelector" 
						items="{/availableLanguages}" 
						selectedKey="{/currentLanguage}"
						change=".onLanguageChange"
						width="8rem">
						<core:Item key="{key}" text="{text}"/>
					</Select>
				</f:actions>
				<f:expandedContent>
					<Title text="{i18n>activeBillingTitle}"/>
				</f:expandedContent>
				<f:snappedContent>
					<Title text="{i18n>activeBillingTitle}"/>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<fb:FilterBar id="filterbar" persistencyKey="myPersKey" useToolbar="false" 
                    search=".onSearch" filterChange=".onFilterChange" clear=".onClear" showClearOnFB="true" afterVariantLoad=".onAfterVariantLoad">
                    <fb:filterGroupItems>

                        <!-- BUKRS (Company, multi input with value help dialog) -->
                     <fb:FilterGroupItem name="BUKRS" label="{i18n>bukrs}" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <MultiInput id="multiInput1"
                                        customData:prop="BUKRS"
                                        showSuggestion="false"
                                        width="70%"
                                        showValueHelp="true"
                                        valueHelpRequest=".onCompanyValueHelpRequest"
                                        tokenUpdate=".onMultiInputTokenUpdate"
                                        change=".onMultiInputChange">
                            </MultiInput>
                        </fb:control>
                    </fb:FilterGroupItem>

                        <!-- BELNR (Document Number, free text, multi input) -->
                        <fb:FilterGroupItem name="BELNR" label="{i18n>belnr}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                 <MultiInput id="multiInput2"
                                        customData:prop="BELNR"
                                        showSuggestion="false"
                                        width="70%"
                                        showValueHelp="false"
                                        tokenUpdate=".onMultiInputTokenUpdate"
                                        change=".onMultiInputChange" />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- GJAHR (Year selection, single year with DatePicker) -->
                        <fb:FilterGroupItem name="GJAHR" label="{i18n>gjahr}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DatePicker
									id="yearSelection"
									value="{filterModel>/GJAHR}"
									change=".onYearChange"
									displayFormat="yyyy"
									valueFormat="yyyy"
									width="100%"/>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- BLDAT (Document Date, date range) -->
                        <fb:FilterGroupItem name="BLDAT" label="{i18n>bldat}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <DateRangeSelection
									id="bldatRangeSelection"
									displayFormat="dd/MM/yyyy"
									change=".onBldatRangeChange"
									value="{filterModel>/BLDATRange}" />
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- BLART (Document Type, multi selection) -->
                        <fb:FilterGroupItem name="BLART" label="{i18n>blart}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <MultiComboBox selectedKeys="{filterModel>/BLART}" change=".onMultiComboBoxChange" items="{filterModel>/documentTypes}">
                                    <core:Item key="{filterModel>key}" text="{filterModel>text}"/>
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- AWSYS (Origin System, match code dropdown, dynamic values) -->
                        <fb:FilterGroupItem name="AWSYS" label="{i18n>awsys}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <MultiComboBox selectedKeys="{filterModel>/AWSYS}" change=".onMultiComboBoxChange" items="{filterModel>/originSystems}">
                                    <core:Item key="{filterModel>key}" text="{filterModel>text}"/>
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- STATUS (Document Status, multi input, match code values) -->
                        <fb:FilterGroupItem name="STATUS" label="{i18n>status}" groupName="Group1" visibleInFilterBar="true">
                            <fb:control>
                                <MultiComboBox selectedKeys="{filterModel>/STATUS}" change=".onMultiComboBoxChange">
                                    <core:Item key="01" text="01-NEW"/>
                                    <core:Item key="02" text="02-WAIT"/>
                                    <core:Item key="03" text="03-SENT"/>
                                    <core:Item key="04" text="04-CANC"/>
                                    <core:Item key="05" text="05-BTP_ERR"/>
                                    <core:Item key="06" text="06-DT_ERR"/>
                                    <core:Item key="07" text="07-RESEND"/>
                                    <core:Item key="08" text="08-COMPLETED"/>
                                    <core:Item key="09" text="09-COMM_ERR"/>
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>

                        <!-- KUNNR (Client Code, multi selection) -->
							<fb:FilterGroupItem name="KUNNR" label="{i18n>kunnr}" groupName="Group1" visibleInFilterBar="true">
								<fb:control>
									<MultiInput id="multiInput3" 
												customData:prop="KUNNR"
												showSuggestion="false"
												width="70%"
												showValueHelp="false"
												tokenUpdate=".onMultiInputTokenUpdate"
												change=".onMultiInputChange" />
								</fb:control>
                        </fb:FilterGroupItem>

                    </fb:filterGroupItems>
                </fb:FilterBar>

				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<table:Table id="tableDocuments"
				width="100%"
				visibleRowCountMode="Auto"
				minAutoRowCount="5"
				selectionMode="Multi"
				fixedColumnCount="5"
				rows="{ path: 'app>/rows' }">
				<table:extension>
					<OverflowToolbar class="sapUiMediumMarginTop">
						<Title text="{i18n>DocumentListTable} ({= ${app>/rows}.length})" level="H2"/>
						<ToolbarSpacer/>
						<!-- <Button text="Test Endpoint" type="Default" icon="sap-icon://test-tube" press=".onTestEndpoint" tooltip="Test any endpoint"/>
						<Button text="Quick Test" type="Default" icon="sap-icon://play" press=".onQuickTestDocumentList" tooltip="Quick test Document List endpoint"/> -->
						<Button text="{i18n>ResendBtn}" type="Emphasized" customData:function="Resend" press=".onTableBtnPressed"/>
						<Button text="{i18n>CancelBtn}" type="Emphasized" customData:function="Cancel" press=".onTableBtnPressed"/>
					</OverflowToolbar>
				</table:extension>
				<table:columns>
					<!-- 1. Company -->
					<table:Column width="8rem" sortProperty="BUKRS" filterProperty="BUKRS">
						<Label text="{i18n>bukrs}"/>
						<table:template>
							<Text text="{app>BUKRS}"/>
						</table:template>
					</table:Column>
					
					<!-- 2. Document number -->
					<table:Column width="10rem" sortProperty="BELNR" filterProperty="BELNR">
						<Label text="{i18n>belnr}"/>
						<table:template>
							<Text text="{app>BELNR}"/>
						</table:template>
					</table:Column>
					
					<!-- 3. Year -->
					<table:Column width="6rem" sortProperty="GJAHR" filterProperty="GJAHR">
						<Label text="{i18n>gjahr}"/>
						<table:template>
							<Text text="{app>GJAHR}"/>
						</table:template>
					</table:Column>
					
					<!-- 4. Status (with badges) -->
					<table:Column width="12rem" sortProperty="STATUS" filterProperty="STATUS">
						<Label text="{i18n>status}"/>
						<table:template>
							<VBox>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusNew" visible="{= ${app>STATUS} === '01'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusWait" visible="{= ${app>STATUS} === '02'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusSent" visible="{= ${app>STATUS} === '03'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusCanc" visible="{= ${app>STATUS} === '04'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusBtpErr" visible="{= ${app>STATUS} === '05'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusDtErr" visible="{= ${app>STATUS} === '06'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusResend" visible="{= ${app>STATUS} === '07'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusCompleted" visible="{= ${app>STATUS} === '08'}"/>
								<Text text="{ path: 'app>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusCommErr" visible="{= ${app>STATUS} === '09'}"/>
							</VBox>
						</table:template>
					</table:Column>
					
					<!-- 5. Buttons (History & Ack User) -->
					<table:Column width="5rem">
						<table:template>
							<HBox>
								<Button 
									type="Transparent" 
									icon="sap-icon://history"
									press=".onHistoryPressed"
									tooltip="{i18n>mainHistoryTooltip}"/>
								<Button 
									type="Transparent" 
									icon="sap-icon://account"
									press=".onAckUserPressed"
									enabled="{= (${app>STATUS} === '05' || ${app>ACK_USER} !== '') &amp;&amp; (${app>STATUS} === '01' || ${app>STATUS} === '02' || ${app>STATUS} === '03' || ${app>STATUS} === '05' || ${app>STATUS} === '06' || ${app>STATUS} === '09')}"
									tooltip="{i18n>mainAckUserTooltip}"/>
							</HBox>
						</table:template>
					</table:Column>
					
					<!-- 6. Invoice type -->
					<table:Column width="10rem" sortProperty="INV_TYPE" filterProperty="INV_TYPE">
						<Label text="{i18n>inv_type}"/>
						<table:template>
							<Text text="{app>INV_TYPE}"/>
						</table:template>
					</table:Column>
					
					<!-- 7. Posting date -->
					<table:Column width="10rem" sortProperty="BUDAT" filterProperty="BUDAT">
						<Label text="{i18n>budat}"/>
						<table:template>
							<Text text="{ path: 'app>BUDAT', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					
					<!-- 8. Document type -->
					<table:Column width="8rem" sortProperty="BLART" filterProperty="BLART">
						<Label text="{i18n>blart}"/>
						<table:template>
							<Text text="{app>BLART}"/>
						</table:template>
					</table:Column>
					
					<!-- 9. Currency -->
					<table:Column width="8rem" sortProperty="CURRENCY" filterProperty="CURRENCY">
						<Label text="{i18n>currency}"/>
						<table:template>
							<Text text="{app>CURRENCY}"/>
						</table:template>
					</table:Column>
					
					<!-- 10. Invoice SD -->
					<table:Column width="10rem" sortProperty="VBELN" filterProperty="VBELN">
						<Label text="{i18n>vbeln}"/>
						<table:template>
							<Text text="{app>VBELN}"/>
						</table:template>
					</table:Column>
					
					<!-- 11. Client code -->
					<table:Column width="10rem" sortProperty="KUNNR" filterProperty="KUNNR">
						<Label text="{i18n>kunnr}"/>
						<table:template>
							<Text text="{app>KUNNR}"/>
						</table:template>
					</table:Column>
					
					<!-- 12. Document date -->
					<table:Column width="10rem" sortProperty="BLDAT" filterProperty="BLDAT">
						<Label text="{i18n>bldat}"/>
						<table:template>
							<Text text="{ path: 'app>BLDAT', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column>
					
					<!-- Remaining columns (not removed) -->
					<table:Column width="8rem" sortProperty="FISC_RAP" filterProperty="FISC_RAP">
						<Label text="{i18n>fisc_rap}"/>
						<table:template>
							<CheckBox selected="{app>FISC_RAP}" 
								enabled="false"/>
						</table:template>
					</table:Column>
					<!-- <table:Column width="12rem" sortProperty="DOC_TYPE_BTP" filterProperty="DOC_TYPE_BTP">
						<Label text="{i18n>doc_type_btp}"/>
						<table:template>
							<Text text="{app>DOC_TYPE_BTP}"/>
						</table:template>
					</table:Column> -->
					<table:Column width="10rem" sortProperty="COUNTRY" filterProperty="COUNTRY">
						<Label text="{i18n>country}"/>
						<table:template>
							<Text text="{app>COUNTRY}"/>
						</table:template>
					</table:Column>
					<!-- <table:Column width="16rem" sortProperty="KSEF_ID" filterProperty="KSEF_ID">
						<Label text="{i18n>ksef_id}"/>
						<table:template>
							<Text text="{app>KSEF_ID}"/>
						</table:template>
					</table:Column>
					<table:Column width="10rem" sortProperty="KSEF_DATE" filterProperty="KSEF_DATE">
						<Label text="{i18n>ksef_date}"/>
						<table:template>
							<Text text="{ path: 'app>KSEF_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
						</table:template>
					</table:Column> -->
					<table:Column width="10rem" sortProperty="ACK_CODE" filterProperty="ACK_CODE">
						<Label text="{i18n>ack_code}"/>
						<table:template>
							<Text text="{app>ACK_CODE}"/>
						</table:template>
					</table:Column>
					<table:Column width="18rem" sortProperty="ACK_DESCRIPTION" filterProperty="ACK_DESCRIPTION">
						<Label text="{i18n>ack_description}"/>
						<table:template>
							<Text text="{app>ACK_DESCRIPTION}"/>
						</table:template>
					</table:Column>
					<table:Column width="12rem" sortProperty="ACK_USER" filterProperty="ACK_USER">
						<Label text="{i18n>status_user}"/>
						<table:template>
							<Text text="{app>ACK_USER}"/>
						</table:template>
					</table:Column>
					<table:Column width="16rem" sortProperty="ACK_USER_DESCR" filterProperty="ACK_USER_DESCR">
						<Label text="{i18n>status_user_description}"/>
						<table:template>
							<Text text="{app>ACK_USER_DESCR}"/>
						</table:template>
					</table:Column>
					<table:Column width="8rem" sortProperty="AWSYS" filterProperty="AWSYS">
						<Label text="{i18n>awsys}"/>
						<table:template>
							<Text text="{app>AWSYS}"/>
						</table:template>
					</table:Column>
				</table:columns>
			</table:Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
