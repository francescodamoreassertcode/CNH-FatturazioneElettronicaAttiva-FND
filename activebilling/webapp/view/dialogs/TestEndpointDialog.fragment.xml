<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog title="Test Endpoint" contentWidth="600px" contentHeight="400px">
        <content>
            <VBox class="sapUiMediumMargin">
                <Label text="Endpoint URL:" class="sapUiTinyMarginTop"/>
                <Input id="testEndpointInput" 
                       placeholder="e.g., /odata/v4/catalg/EINV_DOCUMENT_LIST" 
                       width="100%"/>
                
                <Label text="HTTP Method:" class="sapUiTinyMarginTop"/>
                <Select id="testMethodSelect" width="200px">
                    <core:Item key="GET" text="GET"/>
                    <core:Item key="POST" text="POST"/>
                    <core:Item key="PATCH" text="PATCH"/>
                    <core:Item key="DELETE" text="DELETE"/>
                </Select>
                
                <Label text="Request Body (for POST/PATCH):" class="sapUiTinyMarginTop"/>
                <TextArea id="testRequestBody" 
                          width="100%" 
                          height="100px" 
                          placeholder="JSON body (optional)"/>
                
                <Label text="Response:" class="sapUiTinyMarginTop"/>
                <TextArea id="testResponseArea" 
                          width="100%" 
                          height="150px" 
                          editable="false" 
                          value="Response will appear here..."/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Test" type="Emphasized" press=".onTestEndpointExecute"/>
        </beginButton>
        <endButton>
            <Button text="Close" press=".onTestEndpointClose"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
