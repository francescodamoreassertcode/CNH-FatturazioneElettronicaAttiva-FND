<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="ackUserDialog" title="{i18n>ackUserDialogTitle}" contentWidth="500px" contentHeight="400px">
		<content>
			<VBox class="sapUiMediumMargin">
				<Label text="{i18n>selectAckUserLabel}" class="sapUiMediumMarginBottom"/>
				<ComboBox id="ackUserComboBox" 
					selectedKey="{ackUserModel>/selectedAckCode}" 
					showSecondaryValues="true" 
					width="100%">
					<core:ListItem key="USR01" text="USR01" additionalText="{i18n>ackUserUsr01}"/>
					<core:ListItem key="USR02" text="USR02" additionalText="{i18n>ackUserUsr02}"/>
				</ComboBox>
				
				<Label text="{i18n>ackUserTextLabel}" class="sapUiMediumMarginTop sapUiMediumMarginBottom"/>
				<TextArea id="ackUserTextArea" 
					value="{ackUserModel>/ackUserText}" 
					placeholder="{i18n>ackUserTextPlaceholder}"
					rows="4" 
					width="100%"/>
			</VBox>
		</content>
		<buttons>
			<Button text="{i18n>ackUserCancelBtn}" press=".onAckUserCancel" type="Transparent"/>
			<Button text="{i18n>ackUserSaveBtn}" press=".onAckUserSave" type="Emphasized"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
