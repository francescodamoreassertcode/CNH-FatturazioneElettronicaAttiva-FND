<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:table="sap.ui.table">
	<Dialog id="historyDialog" title="{i18n>historyTitle}" contentWidth="90%" contentHeight="80%">
		<content>
			<VBox class="sapUiMediumMargin">
				<!-- Document Info Header -->
				<HBox class="sapUiMediumMarginBottom">
					<VBox>
						<Label text="{i18n>historyCompanyLabel}" class="sapUiTinyMarginEnd"/>
						<Text text="{historyModel>/currentDocument/BUKRS}" class="sapUiTinyMarginEnd"/>
					</VBox>
					<VBox class="sapUiMediumMarginStart">
						<Label text="{i18n>historyDocumentNumberLabel}" class="sapUiTinyMarginEnd"/>
						<Text text="{historyModel>/currentDocument/BELNR}"/>
					</VBox>
					<VBox class="sapUiMediumMarginStart">
						<Label text="{i18n>historyYearLabel}" class="sapUiTinyMarginEnd"/>
						<Text text="{historyModel>/currentDocument/GJAHR}"/>
					</VBox>
				</HBox>

				<!-- History Table -->
				<table:Table id="historyTable"
					width="100%"
					selectionMode="Multi"
					selectionChange=".onHistorySelectionChange"
					rows="{ path: 'historyModel>/historyData' }">
					<table:rowMode>
						<table:rowmodes.Auto minRowCount="10" hideEmptyRows="true" />
					</table:rowMode>
					<table:extension>
						<OverflowToolbar class="sapUiMediumMarginTop">
							<Title text="{i18n>historyDocumentHistoryTitle}" level="H3"/>
							<ToolbarSpacer/>
							<Button 
								text="{i18n>downloadCsvBtn}" 
								type="Emphasized" 
								icon="sap-icon://download"
								press=".onDownloadCsvPressed"
								enabled="{= ${historyModel>/hasDownloadPermission} === true}"
								tooltip="{i18n>historyDownloadCsvTooltip}"/>
						</OverflowToolbar>
					</table:extension>
					<table:columns>
						<table:Column width="8rem" sortProperty="RECORD_TYPE" filterProperty="RECORD_TYPE">
							<Label text="{i18n>historyRecordTypeLabel}"/>
							<table:template>
								<Text text="{= ${historyModel>RECORD_TYPE} === '01' ? ${i18n>recordTypeSend} : ${i18n>recordTypeAck}}"/>
							</table:template>
						</table:Column>
						<table:Column width="11rem" sortProperty="STATUS" filterProperty="STATUS">
							<Label text="{i18n>historyStatusLabel}"/>
							<table:template>
								<VBox>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusNew" visible="{= ${historyModel>STATUS} === '01'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusWait" visible="{= ${historyModel>STATUS} === '02'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusSent" visible="{= ${historyModel>STATUS} === '03'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusCanc" visible="{= ${historyModel>STATUS} === '04'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusBtpErr" visible="{= ${historyModel>STATUS} === '05'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusDtErr" visible="{= ${historyModel>STATUS} === '06'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusResend" visible="{= ${historyModel>STATUS} === '07'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusCompleted" visible="{= ${historyModel>STATUS} === '08'}"/>
									<Text text="{ path: 'historyModel>STATUS', formatter: '.formatter.formatStatus' }" class="btnStatusCommErr" visible="{= ${historyModel>STATUS} === '09'}"/>
								</VBox>
							</table:template>
						</table:Column>
						<table:Column width="10rem" sortProperty="INSERT_DATE" filterProperty="INSERT_DATE">
							<Label text="{i18n>historyInsertDateLabel}"/>
							<table:template>
								<Text text="{ path: 'historyModel>INSERT_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
							</table:template>
						</table:Column>
						<table:Column width="8rem" sortProperty="TIMESTAMP" filterProperty="TIMESTAMP">
							<Label text="{i18n>historyInsertTimeLabel}"/>
							<table:template>
								<Text text="{ path: 'historyModel>TIMESTAMP', formatter: '.formatter.formatHourOutOfTimestamp' }"/>
							</table:template>
						</table:Column>
						<table:Column width="10rem" sortProperty="UPDATE_DATE" filterProperty="UPDATE_DATE">
							<Label text="{i18n>historyUpdateDateLabel}"/>
							<table:template>
								<Text text="{ path: 'historyModel>UPDATE_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
							</table:template>
						</table:Column>
						<table:Column width="10rem" sortProperty="USER" filterProperty="USER">
							<Label text="{i18n>historyUserUpdateLabel}"/>
							<table:template>
								<Text text="{historyModel>USER}"/>
							</table:template>
						</table:Column>
						<table:Column width="12rem" sortProperty="FILE_NAME" filterProperty="FILE_NAME">
							<Label text="{i18n>historyFileNameLabel}"/>
							<table:template>
								<Text text="{historyModel>FILE_NAME}"/>
							</table:template>
						</table:Column>
						<table:Column width="12rem" sortProperty="ERROR_MESSAGE" filterProperty="ERROR_MESSAGE">
							<Label text="{i18n>historyErrorMessageLabel}"/>
							<table:template>
								<Text text="{historyModel>ERROR_MESSAGE}"/>
							</table:template>
						</table:Column>
						<table:Column width="12rem" sortProperty="ERROR_STEP" filterProperty="ERROR_STEP">
							<Label text="{i18n>historyErrorStepLabel}"/>
							<table:template>
								<Text text="{historyModel>ERROR_STEP}"/>
							</table:template>
						</table:Column>
					</table:columns>
				</table:Table>
			</VBox>
		</content>
		<buttons>
			<Button text="{i18n>historyCloseBtn}" press=".onHistoryDialogClose" type="Transparent"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
