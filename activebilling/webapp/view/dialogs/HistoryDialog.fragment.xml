<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:table="sap.ui.table">
	<Dialog id="historyDialog" title="{i18n>historyTitle}" contentWidth="90%" contentHeight="80%">
		<content>
			<VBox class="sapUiMediumMargin">
				<!-- Document Info Header -->
				<HBox class="sapUiMediumMarginBottom">
					<VBox>
						<Label text="{i18n>historyCompanyLabel}" class="sapUiTinyMarginEnd"/>
						<Text text="{historyModel>/currentDocument/BUKRS}" class="sapUiTinyMarginEnd"/>
					</VBox>
					<VBox class="sapUiMediumMarginStart">
						<Label text="{i18n>historyDocumentNumberLabel}" class="sapUiTinyMarginEnd"/>
						<Text text="{historyModel>/currentDocument/BELNR}"/>
					</VBox>
					<VBox class="sapUiMediumMarginStart">
						<Label text="{i18n>historyYearLabel}" class="sapUiTinyMarginEnd"/>
						<Text text="{historyModel>/currentDocument/GJAHR}"/>
					</VBox>
				</HBox>

				<!-- History Table -->
				<table:Table id="historyTable"
					width="100%"
					visibleRowCountMode="Auto"
					minAutoRowCount="5"
					selectionMode="Single"
					selectionChange=".onHistorySelectionChange"
					rows="{ path: 'historyModel>/historyData' }">
					<table:extension>
						<OverflowToolbar class="sapUiMediumMarginTop">
							<Title text="{i18n>historyDocumentHistoryTitle}" level="H3"/>
							<ToolbarSpacer/>
							<Button 
								text="{i18n>downloadCsvBtn}" 
								type="Emphasized" 
								icon="sap-icon://download"
								press=".onDownloadCsvPressed"
								enabled="{= ${historyModel>/hasDownloadPermission} === true}"
								tooltip="{i18n>historyDownloadCsvTooltip}"/>
						</OverflowToolbar>
					</table:extension>
					<table:columns>
						<table:Column width="8rem" sortProperty="RECORD_TYPE" filterProperty="RECORD_TYPE">
							<Label text="{i18n>historyRecordTypeLabel}"/>
							<table:template>
								<Text text="{= ${historyModel>RECORD_TYPE} === '01' ? ${i18n>recordTypeSend} : ${i18n>recordTypeAck}}"/>
							</table:template>
						</table:Column>
						<table:Column width="6rem" sortProperty="STATUS" filterProperty="STATUS">
							<Label text="{i18n>historyStatusLabel}"/>
							<table:template>
								<Text text="{historyModel>STATUS}"/>
							</table:template>
						</table:Column>
						<table:Column width="8rem" sortProperty="ACK_CODE" filterProperty="ACK_CODE">
							<Label text="{i18n>historyAckCodeLabel}"/>
							<table:template>
								<Text text="{historyModel>ACK_CODE}"/>
							</table:template>
						</table:Column>
						<table:Column width="10rem" sortProperty="INSERT_DATE" filterProperty="INSERT_DATE">
							<Label text="{i18n>historyDateLabel}"/>
							<table:template>
								<Text text="{ path: 'historyModel>INSERT_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
							</table:template>
						</table:Column>
						<table:Column width="8rem" sortProperty="TIMESTAMP" filterProperty="TIMESTAMP">
							<Label text="{i18n>historyTimeLabel}"/>
							<table:template>
								<Text text="{ path: 'historyModel>TIMESTAMP', formatter: '.formatter.formatTimeString' }"/>
							</table:template>
						</table:Column>
						<table:Column width="10rem" sortProperty="USER" filterProperty="USER">
							<Label text="{i18n>historyUserLabel}"/>
							<table:template>
								<Text text="{historyModel>USER}"/>
							</table:template>
						</table:Column>
						<table:Column width="12rem" sortProperty="FILE_NAME" filterProperty="FILE_NAME">
							<Label text="{i18n>historyCsvFileNameLabel}"/>
							<table:template>
								<Text text="{historyModel>FILE_NAME}"/>
							</table:template>
						</table:Column>
						<table:Column width="12rem" sortProperty="FILE_NAME_ACK" filterProperty="FILE_NAME_ACK">
							<Label text="{i18n>historyAckFileNameLabel}"/>
							<table:template>
								<Text text="{historyModel>FILE_NAME_ACK}"/>
							</table:template>
						</table:Column>
						<table:Column width="10rem" sortProperty="ACK_DATE" filterProperty="ACK_DATE">
							<Label text="{i18n>historyAckDateLabel}"/>
							<table:template>
								<Text text="{ path: 'historyModel>ACK_DATE', formatter: '.formatter.formatIsoToDMYDash' }"/>
							</table:template>
						</table:Column>
						<table:Column width="8rem" sortProperty="ACK_TIME" filterProperty="ACK_TIME">
							<Label text="{i18n>historyAckTimeLabel}"/>
							<table:template>
								<Text text="{ path: 'historyModel>ACK_TIME', formatter: '.formatter.formatTimeString' }"/>
							</table:template>
						</table:Column>
						<table:Column width="12rem" sortProperty="FILE_CONTENT_ID" filterProperty="FILE_CONTENT_ID">
							<Label text="{i18n>historyFileContentIdLabel}"/>
							<table:template>
								<Text text="{historyModel>FILE_CONTENT_ID}"/>
							</table:template>
						</table:Column>
						<table:Column width="10rem" sortProperty="ERROR_STEP" filterProperty="ERROR_STEP">
							<Label text="{i18n>historyErrorStepLabel}"/>
							<table:template>
								<Text text="{historyModel>ERROR_STEP}"/>
							</table:template>
						</table:Column>
						<table:Column width="16rem" sortProperty="ERROR_MESSAGE" filterProperty="ERROR_MESSAGE">
							<Label text="{i18n>historyMessageLabel}"/>
							<table:template>
								<Text text="{historyModel>ERROR_MESSAGE}"/>
							</table:template>
						</table:Column>
					</table:columns>
				</table:Table>
			</VBox>
		</content>
		<buttons>
			<Button text="{i18n>historyCloseBtn}" press=".onHistoryDialogClose" type="Transparent"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
